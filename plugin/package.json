{
  "name": "dsh-xcode",
  "version": "0.1.1",
  "description": "Drive the open Xcode workspace through Apple's official Xcode MCP bridge and simctl.",
  "type": "module",
  "license": "MIT",
  "author": "Carl",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "xcode",
    "xcodebuild",
    "simctl",
    "mcp",
    "apple"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "check": "node scripts/check-schemas.mjs",
    "prepack": "npm run check",
    "pack": "npm pack --pack-destination dist"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/check-schemas.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
